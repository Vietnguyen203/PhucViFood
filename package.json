{
  "name": "phucvifoods",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm -r --filter \"./services/*\" run db:generate",
    "db:migrate": "pnpm -r --filter \"./services/*\" run db:migrate",
    "db:seed": "pnpm -r --filter \"./services/*\" run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
