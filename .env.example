# Sao chép thành .env (không commit). Giá trị dưới đây chỉ dùng cho dev local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/user_db
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/catalog_db
ORDERING_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ordering_db
CUSTOMER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/customer_db
TRACKING_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracking_db
AFFILIATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/affiliate_db

RABBITMQ_USER=phucvi
RABBITMQ_PASSWORD=phucvi
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://phucvi:phucvi@localhost:5672

# JWT bất đối xứng (RS256): chỉ user service giữ khóa RIÊNG để ký; mọi service khác chỉ cần khóa CÔNG KHAI để kiểm tra token.
# Sinh cặp khóa rồi dán hai dòng in ra vào đây:  pnpm jwt:keygen
# Khóa nhận dạng PEM nhiều dòng, PEM viết một dòng với \n dạng chữ, hoặc PEM mã hóa base64 một dòng (dạng keygen in ra).
# Dev: các service dùng chung file này nên đều thấy JWT_PRIVATE_KEY nhưng chỉ user service đọc nó. Docker: compose chỉ đưa khóa riêng vào user.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=phucvi
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Khóa API nội bộ giữa các service (vd ordering gọi affiliate), TỐI THIỂU 24 ký tự. Để trống thì service affiliate không khởi động.
# Sinh khóa: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Cổng mặc định: gateway 3000 (cổng duy nhất mở ra ngoài), user 3001, affiliate 3002, catalog 3003, ordering 3004, customer 3005, tracking 3006.
# Các service dùng chung file .env ở gốc. Ordering gọi catalog, affiliate, customer theo các địa chỉ sau;
# gateway chuyển tiếp tới cả 5 service (thêm USER_URL, ORDERING_URL).
USER_URL=http://localhost:3001/api
ORDERING_URL=http://localhost:3004/api
CATALOG_URL=http://localhost:3003/api
AFFILIATE_URL=http://localhost:3002/api
CUSTOMER_URL=http://localhost:3005/api
TRACKING_URL=http://localhost:3006/api
DOWNSTREAM_TIMEOUT_MS=5000
# Chạy riêng từng service thì đặt PORT khi chạy: $env:PORT="3002"; pnpm --filter @phucvi/affiliate dev
PORT=3001
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# Gateway (cổng riêng GATEWAY_PORT, không dùng PORT ở trên).
GATEWAY_PORT=3000
# Số proxy tin cậy đứng trước gateway (Caddy = 1). 0 = không tin X-Forwarded-For. Đặt sai sẽ làm giới hạn tốc độ bị né hoặc chặn nhầm.
TRUST_PROXY_HOPS=0
PROXY_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_PUBLIC_WRITE_PER_MIN=30
RATE_LIMIT_LOOKUP_PER_MIN=30

# Gọi service khác (ordering, customer): retry cho lời gọi idempotent và ngắt mạch khi lỗi liên tiếp.
DOWNSTREAM_RETRY_ATTEMPTS=3
DOWNSTREAM_RETRY_BASE_MS=100
DOWNSTREAM_BREAKER_THRESHOLD=5
DOWNSTREAM_BREAKER_OPEN_MS=10000

# Chạy cả hệ thống trong Docker (pnpm stack:up, xem BE/docs/deploy.md). JWT_PRIVATE_KEY, JWT_PUBLIC_KEY và INTERNAL_API_KEY ở trên PHẢI có giá trị.
# HTTP_PORT=80
# HTTPS_PORT=443
# Đặt tên miền để Caddy tự bật HTTPS, vd api.phucvifoods.vn (mặc định :80, chỉ HTTP).
# SITE_ADDRESS=:80
# RATE_LIMIT_ENABLED=true

# Giữ hàng có hạn. Ordering tự hủy đơn chuyển khoản quá hạn thanh toán (hạn lấy từ cấu hình payment.hold_minutes, mặc định 24 giờ);
# catalog định kỳ trả lại hàng đã giữ cho đơn không bao giờ được tạo (cần ORDERING_URL ở trên).
# ORDER_EXPIRY_ENABLED=true
# ORDER_EXPIRY_INTERVAL_MS=60000
# ORPHAN_SWEEP_ENABLED=true
# ORPHAN_SWEEP_INTERVAL_MS=300000
# ORPHAN_MIN_AGE_MINUTES=10
# ORPHAN_LOOKBACK_HOURS=24

# Dọn outbox đã gửi và inbox đã xử lý (tự động, mọi service; xem BE/docs/shared-library.md mục 3).
# OUTBOX_PURGE_ENABLED=true
# OUTBOX_RETENTION_DAYS=7
# INBOX_RETENTION_DAYS=30
# MAINTENANCE_INTERVAL_MS=3600000
# Docker: false để service không tự áp migration (đã chạy `pnpm stack:migrate` trước).
# RUN_MIGRATIONS=true

# Giao diện web (FE): dev chạy `pnpm --filter figma-make-app dev` (cổng 8443); Vite chuyển tiếp /api tới gateway.
# GATEWAY_URL=http://localhost:3000
# VITE_API_BASE=/api
# Nhớ thêm địa chỉ FE vào CORS_ORIGINS nếu FE gọi API khác nguồn (mặc định FE dùng /api cùng nguồn nên không cần).

# Thư (xác nhận đơn, quên mật khẩu). Dev: Mailpit (pnpm db:up) nhận thư ở cổng 1025, xem tại http://localhost:8025.
#   MAIL_TRANSPORT: smtp (gửi qua SMTP) | log (chỉ in nội dung thư ra log, không gửi)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Phúc Vị Foods <no-reply@phucvifoods.vn>
# Địa chỉ cửa hàng (không có dấu / cuối) dùng làm link trong thư.
PUBLIC_BASE_URL=http://localhost:8443

