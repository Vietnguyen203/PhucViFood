# Sao chép thành .env (không commit). Giá trị dưới đây chỉ dùng cho dev local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/user_db
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/catalog_db
ORDERING_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ordering_db
CUSTOMER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/customer_db
TRACKING_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tracking_db
AFFILIATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/affiliate_db

RABBITMQ_USER=phucvi
RABBITMQ_PASSWORD=phucvi
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://phucvi:phucvi@localhost:5672

# JWT: khóa ký access token, TỐI THIỂU 32 ký tự, mọi service dùng chung một giá trị.
# Sinh khóa ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Để trống thì service user sẽ không khởi động (có báo lỗi rõ ràng).
JWT_ACCESS_SECRET=
JWT_ISSUER=phucvi
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Khóa API nội bộ giữa các service (vd ordering gọi affiliate), TỐI THIỂU 24 ký tự. Để trống thì service affiliate không khởi động.
# Sinh khóa: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Cổng mặc định: gateway 3000 (cổng duy nhất mở ra ngoài), user 3001, affiliate 3002, catalog 3003, ordering 3004, customer 3005, tracking 3006.
# Các service dùng chung file .env ở gốc. Ordering gọi catalog, affiliate, customer theo các địa chỉ sau;
# gateway chuyển tiếp tới cả 5 service (thêm USER_URL, ORDERING_URL).
USER_URL=http://localhost:3001/api
ORDERING_URL=http://localhost:3004/api
CATALOG_URL=http://localhost:3003/api
AFFILIATE_URL=http://localhost:3002/api
CUSTOMER_URL=http://localhost:3005/api
TRACKING_URL=http://localhost:3006/api
DOWNSTREAM_TIMEOUT_MS=5000
# Chạy riêng từng service thì đặt PORT khi chạy: $env:PORT="3002"; pnpm --filter @phucvi/affiliate dev
PORT=3001
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# Gateway (cổng riêng GATEWAY_PORT, không dùng PORT ở trên).
GATEWAY_PORT=3000
# Số proxy tin cậy đứng trước gateway (Caddy = 1). 0 = không tin X-Forwarded-For. Đặt sai sẽ làm giới hạn tốc độ bị né hoặc chặn nhầm.
TRUST_PROXY_HOPS=0
PROXY_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_PUBLIC_WRITE_PER_MIN=30
RATE_LIMIT_LOOKUP_PER_MIN=30

# Gọi service khác (ordering, customer): retry cho lời gọi idempotent và ngắt mạch khi lỗi liên tiếp.
DOWNSTREAM_RETRY_ATTEMPTS=3
DOWNSTREAM_RETRY_BASE_MS=100
DOWNSTREAM_BREAKER_THRESHOLD=5
DOWNSTREAM_BREAKER_OPEN_MS=10000
