// Catalog service: danh mục và sản phẩm.
// Database: catalog_db, schema: catalog.
// Quy tắc: không khóa ngoại sang service khác. Đơn hàng (service ordering) chỉ lưu product_id kèm snapshot tên và giá.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
  schemas  = ["catalog"]
}

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  /// Xóa mềm: danh mục đã xóa biến khỏi mọi nơi nhưng giữ dòng để các sản phẩm đã xóa mềm vẫn tham chiếu hợp lệ.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
  @@schema("catalog")
}

model Product {
  id            String    @id @default(uuid(7)) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String
  slug          String    @unique
  sku           String?   @unique
  description   String?
  unit          String? // vd "hộp 500g"
  price         BigInt // VND
  originalPrice BigInt?   @map("original_price") // giá gốc, >= price
  imageUrl      String?   @map("image_url")
  stockQuantity Int       @default(0) @map("stock_quantity")
  isVisible     Boolean   @default(true) @map("is_visible")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6) // xóa mềm vì đơn cũ vẫn tham chiếu
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category      Category  @relation(fields: [categoryId], references: [id])
  movements     StockMovement[]

  @@index([categoryId])
  @@index([isVisible, deletedAt])
  @@map("products")
  @@schema("catalog")
}

// Sổ cái tồn kho: mọi thay đổi stock_quantity (trừ tồn đầu kỳ của seed) đều có một dòng ở đây.
// Mã lý do (SMALLINT, shared-library contracts/codes.ts): 1 ORDER_PLACED (giữ hàng), 2 ORDER_CANCELLED (trả hàng), 3 ADMIN_ADJUSTMENT.
// Partial unique (order_id, product_id, reason) trong migration giúp giữ hàng và trả hàng idempotent theo đơn.
model StockMovement {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  delta     Int // âm = giảm tồn, dương = tăng tồn; khác 0
  reason    Int      @db.SmallInt // StockMovementReasonCode
  orderId   String?  @map("order_id") @db.Uuid // ordering.orders.id (không FK)
  note      String?
  createdBy String?  @map("created_by") @db.Uuid // user.users.id của admin khi điều chỉnh tay
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
  @@schema("catalog")
}

// Inbox: consumer ghi message_id để xử lý idempotent (vd trừ tồn kho khi nhận order.placed).
model InboxEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([messageId, consumer])
  @@map("inbox_events")
  @@schema("catalog")
}

// Transactional outbox: ghi cùng transaction nghiệp vụ, relay đẩy lên RabbitMQ.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("catalog")
}
