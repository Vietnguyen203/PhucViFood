// Affiliate service gồm 2 miền: affiliate, commission. (Tracking đã tách thành service riêng, database tracking_db.)
// Database: affiliate_db. Mỗi miền một Postgres schema.
// Quy tắc: khóa ngoại chỉ trong cùng một miền; tham chiếu miền khác chỉ lưu UUID.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("AFFILIATE_DATABASE_URL")
  schemas  = ["affiliate", "commission"]
}

// ───────────────────────── Mã số enum ─────────────────────────
// Enum lưu dạng SMALLINT. Mã số định nghĩa ở shared-library (contracts/codes.ts), CHECK trong migration.
//   affiliates.status:       1 PENDING, 2 ACTIVE, 3 SUSPENDED, 4 REJECTED
//   commissions.status:      1 ESTIMATED, 2 CONFIRMED, 3 PAID, 4 CANCELLED
//   commissions.confirmed_by: 1 CUSTOMER, 2 ADMIN

// ───────────────────────── schema: affiliate ─────────────────────────

model Affiliate {
  id                String          @id @default(uuid(7)) @db.Uuid
  userId            String          @unique @map("user_id") @db.Uuid // user.users.id (không FK)
  fullName          String          @map("full_name")
  phone             String          @unique // +84xxxxxxxxx
  referralCode      String          @unique @map("referral_code") // 4-12 ký tự a-z0-9, lưu chữ thường
  status            Int             @default(1) @db.SmallInt // AffiliateStatusCode, mặc định 1 = PENDING
  contractStart     DateTime?       @map("contract_start") @db.Date
  contractEnd       DateTime?       @map("contract_end") @db.Date // gồm cả ngày cuối
  commissionRateBps Int             @default(1000) @map("commission_rate_bps") // 1000 = 10,00%
  bankName          String?         @map("bank_name")
  bankAccountNo     String?         @map("bank_account_no")
  bankAccountHolder String?         @map("bank_account_holder")
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(6)
  note              String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  links             AffiliateLink[]

  @@map("affiliates")
  @@schema("affiliate")
}

model AffiliateLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  affiliateId String    @map("affiliate_id") @db.Uuid
  channelCode String    @map("channel_code") // dùng cho ?c= (a-z0-9_-)
  label       String
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, channelCode])
  @@map("affiliate_links")
  @@schema("affiliate")
}

model AffiliateSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
  @@schema("affiliate")
}

model AffiliateOutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("affiliate")
}

// ───────────────────────── schema: commission ─────────────────────────

model Commission {
  id          String           @id @default(uuid(7)) @db.Uuid
  orderId     String           @unique @map("order_id") @db.Uuid // ordering.orders.id; UNIQUE chống tạo trùng
  orderCode   String           @map("order_code") // lưu sẵn để hiển thị
  affiliateId String           @map("affiliate_id") @db.Uuid
  linkId      String?          @map("link_id") @db.Uuid
  channelCode String?          @map("channel_code")
  rateBps     Int              @map("rate_bps") // snapshot tại thời điểm đặt
  baseAmount  BigInt           @map("base_amount") // tổng giá sản phẩm, không tính ship
  amount      BigInt // floor(base_amount * rate_bps / 10000)
  status      Int              @default(1) @db.SmallInt // CommissionStatusCode, mặc định 1 = ESTIMATED
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy Int?             @map("confirmed_by") @db.SmallInt // ConfirmSourceCode
  paidAt      DateTime?        @map("paid_at") @db.Timestamptz(6)
  payoutId    String?          @map("payout_id") @db.Uuid
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?         @map("cancel_reason")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  payout      Payout?          @relation(fields: [payoutId], references: [id])

  @@index([affiliateId, status])
  @@index([payoutId])
  @@map("commissions")
  @@schema("commission")
}

model Payout {
  id               String       @id @default(uuid(7)) @db.Uuid
  affiliateId      String       @map("affiliate_id") @db.Uuid
  totalAmount      BigInt       @map("total_amount")
  paidAt           DateTime     @map("paid_at") @db.Timestamptz(6)
  paymentReference String?      @map("payment_reference")
  note             String?
  createdBy        String       @map("created_by") @db.Uuid // user.users.id của admin
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  commissions      Commission[]

  @@index([affiliateId, paidAt])
  @@map("payouts")
  @@schema("commission")
}

// Inbox: consumer ghi message_id để xử lý idempotent khi RabbitMQ gửi lặp.
model CommissionInboxEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([messageId, consumer])
  @@map("inbox_events")
  @@schema("commission")
}

model CommissionOutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("commission")
}
