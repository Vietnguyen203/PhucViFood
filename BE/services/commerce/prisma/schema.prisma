// Commerce service gồm 3 miền: catalog, ordering, customer.
// Database: commerce_db. Mỗi miền một Postgres schema để tách service sau này.
// Quy tắc: khóa ngoại chỉ trong cùng một miền; tham chiếu miền khác chỉ lưu UUID
// (vd orders.customer_id, order_items.product_id KHÔNG có FK).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("COMMERCE_DATABASE_URL")
  schemas  = ["catalog", "ordering", "customer"]
}

// ───────────────────────── Enums ─────────────────────────

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED

  @@schema("ordering")
}

enum PaymentMethod {
  COD
  BANK_QR

  @@schema("ordering")
}

// COD: PENDING -> PAID (khi shipper nộp tiền). BANK_QR: UNPAID -> PAID (admin đối soát tay).
enum PaymentStatus {
  PENDING
  UNPAID
  PAID
  REFUNDED

  @@schema("ordering")
}

enum AttributionSource {
  LINK
  CODE

  @@schema("ordering")
}

enum ReceivedBy {
  CUSTOMER
  ADMIN

  @@schema("ordering")
}

enum ActorType {
  SYSTEM
  CUSTOMER
  ADMIN

  @@schema("ordering")
}

enum ContactChannel {
  CALL
  ZALO
  SMS

  @@schema("ordering")
}

// ───────────────────────── schema: catalog ─────────────────────────

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
  @@schema("catalog")
}

model Product {
  id            String    @id @default(uuid(7)) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String
  slug          String    @unique
  sku           String?   @unique
  description   String?
  unit          String? // vd "hộp 500g"
  price         BigInt // VND
  originalPrice BigInt?   @map("original_price") // giá gốc, >= price
  imageUrl      String?   @map("image_url")
  stockQuantity Int       @default(0) @map("stock_quantity")
  isVisible     Boolean   @default(true) @map("is_visible")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6) // xóa mềm vì đơn cũ vẫn tham chiếu
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category      Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isVisible, deletedAt])
  @@map("products")
  @@schema("catalog")
}

model CatalogInboxEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([messageId, consumer])
  @@map("inbox_events")
  @@schema("catalog")
}

model CatalogOutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("catalog")
}

// ───────────────────────── schema: ordering ─────────────────────────

model Order {
  id                String             @id @default(uuid(7)) @db.Uuid
  code              String             @unique // PV-yymmdd-XXXX
  customerId        String             @map("customer_id") @db.Uuid // customer.customers.id (không FK)
  status            OrderStatus        @default(PLACED)
  paymentMethod     PaymentMethod      @map("payment_method")
  paymentStatus     PaymentStatus      @map("payment_status")
  // Tiền (VND). total = subtotal + shipping_fee. Hoa hồng chỉ tính trên subtotal.
  subtotalAmount    BigInt             @map("subtotal_amount")
  shippingFee       BigInt             @default(0) @map("shipping_fee")
  totalAmount       BigInt             @map("total_amount")
  // Snapshot ghi nhận CTV tại thời điểm đặt. Hết hạn/không hợp lệ => affiliate_id null (khách vãng lai).
  affiliateId       String?            @map("affiliate_id") @db.Uuid // affiliate.affiliates.id (không FK)
  linkId            String?            @map("link_id") @db.Uuid
  channelCode       String?            @map("channel_code")
  referralCodeUsed  String?            @map("referral_code_used") // mã khách nhập hoặc mã từ cookie
  attributionSource AttributionSource? @map("attribution_source")
  isSelfPurchase    Boolean            @default(false) @map("is_self_purchase") // CTV tự mua: không có hoa hồng
  // Snapshot giao hàng (cấp hành chính sau 1/7/2025: tỉnh/thành + phường/xã)
  shipName          String             @map("ship_name")
  shipPhone         String             @map("ship_phone")
  shipProvince      String             @map("ship_province")
  shipWard          String             @map("ship_ward")
  shipAddressLine   String             @map("ship_address_line")
  customerNote      String?            @map("customer_note")
  placedAt          DateTime           @default(now()) @map("placed_at") @db.Timestamptz(6)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  returnedAt        DateTime?          @map("returned_at") @db.Timestamptz(6)
  receivedBy        ReceivedBy?        @map("received_by")
  cancelReason      String?            @map("cancel_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             OrderItem[]
  history           OrderStatusHistory[]
  careNotes         CareNote[]

  @@index([customerId, placedAt])
  @@index([affiliateId, placedAt])
  @@index([status, placedAt])
  @@index([placedAt])
  @@map("orders")
  @@schema("ordering")
}

model OrderItem {
  id          String @id @default(uuid(7)) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid // catalog.products.id (không FK)
  productName String @map("product_name") // snapshot
  unitPrice   BigInt @map("unit_price") // snapshot
  quantity    Int
  lineTotal   BigInt @map("line_total")
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@map("order_items")
  @@schema("ordering")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
  @@schema("ordering")
}

model CareNote {
  id             String          @id @default(uuid(7)) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  note           String
  contactChannel ContactChannel? @map("contact_channel")
  contactedAt    DateTime        @default(now()) @map("contacted_at") @db.Timestamptz(6)
  createdBy      String          @map("created_by") @db.Uuid // identity.users.id
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, contactedAt])
  @@map("care_notes")
  @@schema("ordering")
}

model OrderingSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
  @@schema("ordering")
}

model OrderingOutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("ordering")
}

// ───────────────────────── schema: customer ─────────────────────────
// Phân loại khách (mới/quen/VIP, hoạt động/sắp rời/đã rời) KHÔNG lưu cột: tính khi truy vấn từ đơn.

model Customer {
  id                 String    @id @default(uuid(7)) @db.Uuid
  phone              String    @unique // +84xxxxxxxxx (9 chữ số sau +84)
  fullName           String    @map("full_name")
  email              String?
  province           String?
  ward               String?
  addressLine        String?   @map("address_line") // địa chỉ gần nhất; lịch sử nằm ở snapshot của đơn
  firstAffiliateId   String?   @map("first_affiliate_id") @db.Uuid // nguồn đầu tiên (không FK)
  firstChannelCode   String?   @map("first_channel_code")
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(6)
  consentWithdrawnAt DateTime? @map("consent_withdrawn_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([province])
  @@index([firstAffiliateId])
  @@map("customers")
  @@schema("customer")
}

model ExportLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  exportedBy String   @map("exported_by") @db.Uuid // identity.users.id của admin
  filters    Json?
  rowCount   Int      @map("row_count")
  format     String   @default("xlsx")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("export_logs")
  @@schema("customer")
}

model CustomerSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
  @@schema("customer")
}

model CustomerInboxEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([messageId, consumer])
  @@map("inbox_events")
  @@schema("customer")
}

model CustomerOutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  @@map("outbox_events")
  @@schema("customer")
}
