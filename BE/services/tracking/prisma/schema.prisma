// Tracking service: lượt bấm link giới thiệu và tương tác của người xem (chỉ để thống kê, không trả tiền).
// Database: tracking_db, schema: tracking.
// Mã CTV, link, thời hạn cookie thuộc service affiliate: tracking chỉ lưu affiliate_id/link_id (UUID, không khóa ngoại)
// và hỏi affiliate qua API nội bộ khi cần kiểm tra mã. Dữ liệu lớn: sau này cân nhắc partition theo tháng.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("TRACKING_DATABASE_URL")
  schemas  = ["tracking"]
}

// ───────────────────────── Mã số enum ─────────────────────────
// Enum lưu dạng SMALLINT. Mã số định nghĩa ở shared-library (contracts/codes.ts), CHECK trong migration.
//   tracking_events.type: 1 PRODUCT_VIEW, 2 ADD_TO_CART, 3 CHECKOUT_START

model ReferralClick {
  id          String   @id @default(uuid(7)) @db.Uuid
  affiliateId String   @map("affiliate_id") @db.Uuid // affiliate.affiliates.id (không FK)
  linkId      String?  @map("link_id") @db.Uuid // affiliate.affiliate_links.id (không FK)
  channelCode String?  @map("channel_code")
  visitorId   String   @map("visitor_id") @db.Uuid // cookie người xem
  landingPath String   @map("landing_path")
  userAgent   String?  @map("user_agent")
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([affiliateId, createdAt])
  @@index([visitorId])
  @@map("referral_clicks")
  @@schema("tracking")
}

model TrackingEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  affiliateId String   @map("affiliate_id") @db.Uuid
  visitorId   String   @map("visitor_id") @db.Uuid
  channelCode String?  @map("channel_code")
  type        Int      @db.SmallInt // TrackingEventTypeCode
  productId   String?  @map("product_id") @db.Uuid // catalog.products.id (không FK)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([affiliateId, type, createdAt])
  @@index([visitorId])
  @@map("tracking_events")
  @@schema("tracking")
}
