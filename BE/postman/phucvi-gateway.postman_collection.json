    {
      "name": "3. Giới hạn kích thước",
      "item": [
        {
          "name": "3.1 Nội dung quá 1 MB bị từ chối ngay ở gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"note\": \"{{big}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "MAX_BODY_BYTES mặc định 1.048.576 byte; gateway trả 413 trước khi chuyển tiếp."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('big', 'x'.repeat(1100000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 413\", function () { pm.response.to.have.status(413); });",
                  "pm.test(\"lỗi VALIDATION_FAILED theo phong bì chuẩn\", function () { const j = pm.response.json(); pm.expect(j.success).to.eql(false); pm.expect(j.error.code).to.eql(\"VALIDATION_FAILED\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
