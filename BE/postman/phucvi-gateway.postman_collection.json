{
  "info": {
    "name": "Phúc Vị Foods - Gateway",
    "description": "Kiểm thử cổng vào: định tuyến, chặn /internal, CORS, mã yêu cầu, giới hạn kích thước. Cần chạy đủ 6 service phía sau. Biến gatewayUrl lấy từ environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "0. Sức khỏe",
      "item": [
        {
          "name": "0.1 Gateway còn sống",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"service gateway, trạng thái ok\", function () { const d = pm.response.json().data; pm.expect(d.service).to.eql('gateway'); pm.expect(d.status).to.eql('ok'); });",
                  "pm.test(\"có x-request-id hợp lệ\", function () { pm.expect(pm.response.headers.get('x-request-id')).to.match(/^[\\w.-]{8,64}$/); });",
                  "pm.test(\"không lộ X-Powered-By\", function () { pm.expect(pm.response.headers.has('x-powered-by')).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Tình trạng 6 service phía sau",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/health/services",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "health",
                "services"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"đủ 6 service, tất cả up (cần chạy đủ 6 service)\", function () { const d = pm.response.json().data; pm.expect(Object.keys(d.services).sort()).to.eql(['affiliate','catalog','customer','ordering','tracking','user']); Object.values(d.services).forEach(function (s) { pm.expect(s.status).to.eql('up'); pm.expect(s.latencyMs).to.be.a('number'); }); pm.expect(d.status).to.eql('ok'); });",
                  "pm.test(\"không lộ địa chỉ nội bộ\", function () { pm.expect(pm.response.text()).to.not.match(/localhost|127\\.0\\.0\\.1|http:\\/\\//); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Mã yêu cầu và CORS",
      "item": [
        {
          "name": "1.1 Nhận lại x-request-id hợp lệ của client",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "postman-trace-abc12345"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"trả lại đúng mã\", function () { pm.expect(pm.response.headers.get('x-request-id')).to.eql('postman-trace-abc12345'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Mã yêu cầu sai định dạng bị thay bằng mã mới",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "gia mao!"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"mã mới hợp lệ\", function () { const id = pm.response.headers.get('x-request-id'); pm.expect(id).to.not.eql('gia mao!'); pm.expect(id).to.match(/^[\\w.-]{8,64}$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Preflight CORS từ web (localhost:5173)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "pm.test(\"cho phép origin\", function () { pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql('http://localhost:5173'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Origin lạ không được cho phép",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://evil.example"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"không có Access-Control-Allow-Origin\", function () { pm.expect(pm.response.headers.has('access-control-allow-origin')).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Header tải file được lộ cho trình duyệt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"expose Content-Disposition và X-Row-Count\", function () { const h = pm.response.headers.get('access-control-expose-headers') || ''; pm.expect(h).to.include('Content-Disposition'); pm.expect(h).to.include('X-Row-Count'); });"
                ]
              }
            }
          ]
        }
      ]
    },
