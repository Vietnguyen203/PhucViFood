                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.collectionVariables.set(\"rid\", id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"slug tự sinh không dấu\", function () { const c = pm.response.json().data; pm.expect(c.slug).to.match(/^[a-z0-9-]+$/); pm.expect(c.slug).to.include('hai-san'); });",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().data.id);",
                  "pm.collectionVariables.set(\"categorySlug\", pm.response.json().data.slug);"
                ]
              }
            }
