            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"đơn thuộc CTV, kênh tiktok\", function () { const o = pm.response.json().data.find(function (x) { return x.code === pm.collectionVariables.get('orderCode'); }); pm.expect(o).to.be.an('object'); pm.expect(o.channelCode).to.eql('tiktok'); pm.expect(o.isSelfPurchase).to.eql(false); });"
                ]
              }
            }
          ]
        }
