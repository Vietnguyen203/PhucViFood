    {
      "name": "4. Cookie từ tracking dùng được khi đặt hàng",
      "item": [
        {
          "name": "4.1 Khách đặt hàng kèm cookie vừa nhận từ tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "orders"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"paymentMethod\": \"COD\",\n  \"customer\": {\n    \"fullName\": \"Postman Khách {{rid}}\",\n    \"phone\": \"{{phone}}\",\n    \"province\": \"Thành phố Hà Nội\",\n    \"ward\": \"Phường Cầu Giấy\",\n    \"addressLine\": \"12 Trần Thái Tông\"\n  },\n  \"cookie\": {{cookie}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.collectionVariables.set(\"rid\", id);",
                  "pm.collectionVariables.set(\"phone\", '09' + String(Math.floor(10000000 + Math.random() * 89999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"orderCode\", pm.response.json().data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 CTV thấy đơn được ghi nhận theo link (kênh tiktok, không phải tự mua)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/me/orders",
