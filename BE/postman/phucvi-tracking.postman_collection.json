                "{{affiliateId}}",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractStart\": \"{{contractStart}}\",\n  \"contractEnd\": \"{{contractEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d0 = new Date(); const iso = function (d) { return d.toISOString().slice(0, 10); }; pm.collectionVariables.set('contractStart', iso(new Date(d0.getTime() - 86400000))); pm.collectionVariables.set('contractEnd', iso(new Date(d0.getTime() + 365 * 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
