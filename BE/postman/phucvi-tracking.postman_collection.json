    {
      "name": "1. Bấm link giới thiệu (công khai)",
      "item": [
        {
          "name": "1.1 Bấm link kênh tiktok: trả cookie, gắn link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/public/referrals/click",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "public",
                "referrals",
                "click"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{refCodeUpper}}\",\n  \"channel\": \"TikTok\",\n  \"landingPath\": \"/r/{{refCode}}?c=tiktok\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Tracking hỏi affiliate để xác nhận mã và lấy link theo kênh, rồi ghi lượt bấm."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('refCodeUpper', pm.collectionVariables.get('refCode').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"valid, cookie đúng mã, kênh chữ thường, 30 ngày\", function () { const d = pm.response.json().data; pm.expect(d.valid).to.eql(true); pm.expect(d.cookie.code).to.eql(pm.collectionVariables.get('refCode')); pm.expect(d.cookie.channelCode).to.eql('tiktok'); pm.expect(d.cookie.maxAgeDays).to.eql(30); });",
                  "pm.test(\"cấp visitorId UUID\", function () { pm.expect(pm.response.json().data.visitorId).to.match(/^[0-9a-f-]{36}$/); });",
                  "pm.collectionVariables.set(\"visitorId\", pm.response.json().data.visitorId);",
                  "pm.collectionVariables.set(\"cookie\", JSON.stringify(pm.response.json().data.cookie));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Bấm lại với cùng visitorId, kênh chưa có link",
          "request": {
            "method": "POST",
            "header": [
              {
