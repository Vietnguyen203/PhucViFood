                  "pm.test(\"theo kênh: tiktok 1, zalo 1\", function () { const by = {}; pm.response.json().data.clicks.byChannel.forEach(function (x) { by[x.channelCode] = x.clicks; }); pm.expect(by).to.eql({ tiktok: 1, zalo: 1 }); });",
                  "pm.test(\"sự kiện theo loại\", function () { const e = pm.response.json().data.events; const t = e.map(function (x) { return x.type; }).sort(); pm.expect(t).to.eql(['ADD_TO_CART', 'CHECKOUT_START', 'PRODUCT_VIEW']); });"
